diff --git a/tests/e2e_client.zig b/tests/e2e_client.zig
new file mode 100644
index 0000000..4ac02f6
--- /dev/null
+++ b/tests/e2e_client.zig
@@ -0,0 +1,71 @@
+//! Drives the real WILD client against a running `e2e-server`.
+//!
+//! It uses the production client (`src/client.zig`) over a real TCP socket and
+//! checks one set, one get, and one delete. It exits nonzero on any mismatch,
+//! so it can run in CI.
+//!
+//!     ./zig-out/bin/e2e-server 7878 testsecret &
+//!     ./zig-out/bin/e2e-client 127.0.0.1:7878 testsecret
+//!
+//! The first message on a connection is the auth secret, which the server
+//! expects and `wild-client` never sends. This harness sends it. That gap is
+//! documented in docs/MIGRATION_0.17.md.
+
+const std = @import("std");
+const wildb_lib = @import("wildb_lib");
+
+const client = wildb_lib.client;
+
+pub fn main(init: std.process.Init) !void {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+
+    if (args.len < 3) {
+        std.debug.print("Usage: e2e-client <address:port> <auth-secret>\n", .{});
+        return error.Usage;
+    }
+
+    const colon = std.mem.indexOfScalar(u8, args[1], ':') orelse {
+        std.debug.print("e2e: address must be address:port\n", .{});
+        return error.BadAddress;
+    };
+    const address = args[1][0..colon];
+    const port = try std.fmt.parseInt(u16, args[1][colon + 1 ..], 10);
+    const auth_secret = args[2];
+
+    var arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
+    defer arena.deinit();
+    const allocator = arena.allocator();
+
+    var wc = try client.WildClient.init(address, port);
+    try wc.connect();
+    defer wc.disconnect();
+
+    try wc.authenticate(auth_secret);
+
+    try wc.set("e2e-key", "e2e-value");
+    std.debug.print("e2e: set e2e-key = e2e-value\n", .{});
+
+    const got = try wc.get("e2e-key", allocator) orelse {
+        std.debug.print("e2e: FAIL get returned null right after set\n", .{});
+        return error.ValueMissing;
+    };
+    if (!std.mem.eql(u8, got, "e2e-value")) {
+        std.debug.print("e2e: FAIL expected e2e-value, got {s}\n", .{got});
+        return error.WrongValue;
+    }
+    std.debug.print("e2e: get e2e-key = {s}\n", .{got});
+
+    if (!try wc.delete("e2e-key")) {
+        std.debug.print("e2e: FAIL delete reported false\n", .{});
+        return error.DeleteFailed;
+    }
+    std.debug.print("e2e: delete e2e-key\n", .{});
+
+    if (try wc.get("e2e-key", allocator) != null) {
+        std.debug.print("e2e: FAIL get still returns the value after delete\n", .{});
+        return error.DeleteNotVisible;
+    }
+    std.debug.print("e2e: get e2e-key = null\n", .{});
+
+    std.debug.print("e2e: PASS set, get, and delete over TCP\n", .{});
+}
diff --git a/tests/e2e_concurrency.zig b/tests/e2e_concurrency.zig
new file mode 100644
index 0000000..b7adc8e
--- /dev/null
+++ b/tests/e2e_concurrency.zig
@@ -0,0 +1,186 @@
+//! Concurrency regression test for the io_uring accept loop.
+//!
+//! Connections used to be stored in arrays that were compacted on disconnect:
+//! the last client was copied into the freed slot. The read of that moved
+//! client was already posted in the ring, tagged with its old index, so its
+//! next completion pointed past the end of the array and was dropped. The
+//! visible symptom is a connection that never gets an answer: a peer of the
+//! client that just hung up goes quiet forever.
+//!
+//! Slots are stable now, and the completion tag carries a generation. This test
+//! reproduces the exact sequence that used to break it: several authenticated
+//! connections sitting idle with a read posted, then one of them disconnects,
+//! then every remaining connection has to get its own answer.
+//!
+//! Run with: zig build && ./zig-out/bin/e2e-concurrency
+
+const std = @import("std");
+const wildb_lib = @import("wildb_lib");
+
+const wild = wildb_lib.wild;
+const server_mod = wildb_lib.server;
+const client_mod = wildb_lib.client;
+const static_allocator = wildb_lib.static_allocator;
+const os_compat = wildb_lib.os_compat;
+
+const secret = "concurrency-secret";
+const survivors = 6;
+const port: u16 = 7911;
+const watchdog_ms = 20_000;
+
+fn fail(comptime format: []const u8, args: anytype) noreturn {
+    std.debug.print("e2e-concurrency: FAIL " ++ format ++ "\n", args);
+    std.process.exit(1);
+}
+
+fn serve(srv: *server_mod.WildServer) void {
+    srv.start() catch |err| {
+        std.debug.print("e2e-concurrency: server stopped: {t}\n", .{err});
+    };
+}
+
+/// If the accept loop has dropped a completion, a client blocks forever. A
+/// watchdog turns that hang into a failure with a reason.
+fn watchdog() void {
+    var waited: u64 = 0;
+    while (waited < watchdog_ms) : (waited += 100) {
+        os_compat.sleep(100 * std.time.ns_per_ms);
+    }
+    std.debug.print("e2e-concurrency: FAIL no answer from the server within {}ms\n", .{watchdog_ms});
+    std.debug.print("  A dropped io_uring completion is the usual cause: the loop\n", .{});
+    std.debug.print("  stopped posting a read for one connection, so it is quiet forever.\n", .{});
+    std.process.exit(1);
+}
+
+fn connectAndAuthenticate(who: []const u8) os_compat.fd_t {
+    const fd = os_compat.socket(std.posix.AF.INET, std.posix.SOCK.STREAM, 0) catch |err| {
+        fail("{s}: socket: {t}", .{ who, err });
+    };
+
+    var addr = os_compat.Address.parseIp("127.0.0.1", port) catch |err| {
+        fail("{s}: parseIp: {t}", .{ who, err });
+    };
+
+    os_compat.connect(fd, &addr.any, addr.getOsSockLen()) catch |err| {
+        fail("{s}: connect: {t}", .{ who, err });
+    };
+
+    // The first message on a connection is the shared secret, and the server
+    // answers with one byte: 0 for accepted.
+    const sent = os_compat.send(fd, secret, 0) catch |err| {
+        fail("{s}: send secret: {t}", .{ who, err });
+    };
+    if (sent != secret.len) fail("{s}: short secret write", .{who});
+
+    var ack: [1]u8 = undefined;
+    const n = os_compat.recv(fd, &ack, 0) catch |err| {
+        fail("{s}: auth reply: {t}", .{ who, err });
+    };
+    if (n != 1 or ack[0] != 0) fail("{s}: auth refused", .{who});
+
+    return fd;
+}
+
+pub fn main() !void {
+    var arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
+    defer arena.deinit();
+    const alloc = arena.allocator();
+
+    var database_arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
+    defer database_arena.deinit();
+    var static_alloc = static_allocator.StaticAllocator.init(database_arena.allocator());
+
+    var database = try wild.WILD.init(static_alloc.allocator(), .{ .target_capacity = 100_000 });
+
+    var srv = try server_mod.WildServer.init(&database, &static_alloc, "127.0.0.1", port, secret);
+    static_alloc.transitionToStatic();
+
+    const thread = try std.Thread.spawn(.{}, serve, .{&srv});
+    defer thread.join();
+
+    _ = std.Thread.spawn(.{}, watchdog, .{}) catch {};
+
+    // Wait for the listener.
+    var attempt: usize = 0;
+    while (true) : (attempt += 1) {
+        const probe = os_compat.socket(std.posix.AF.INET, std.posix.SOCK.STREAM, 0) catch |err| {
+            fail("socket for probe: {t}", .{err});
+        };
+        var addr = try os_compat.Address.parseIp("127.0.0.1", port);
+        if (os_compat.connect(probe, &addr.any, addr.getOsSockLen())) {
+            os_compat.close(probe);
+            break;
+        } else |_| {
+            os_compat.close(probe);
+            if (attempt > 400) fail("server never started listening on {}", .{port});
+            os_compat.sleep(5 * std.time.ns_per_ms);
+        }
+    }
+
+    // The sacrificial connection takes the lowest slot, so it is not the last
+    // client. That is the arrangement that used to corrupt the last client's
+    // in-flight read when this one went away.
+    const sacrificial = connectAndAuthenticate("sacrificial");
+
+    var clients: [survivors]client_mod.WildClient = undefined;
+    for (&clients, 0..) |*client, i| {
+        client.* = try client_mod.WildClient.init("127.0.0.1", port);
+        try client.connect();
+        client.authenticate(secret) catch |err| fail("client {d}: authenticate: {t}", .{ i, err });
+
+        const key = try std.fmt.allocPrint(alloc, "ck{}", .{i});
+        const value = try std.fmt.allocPrint(alloc, "value-from-{d}", .{i});
+        client.set(key, value) catch |err| fail("client {d}: set: {t}", .{ i, err });
+    }
+
+    // Every connection now sits idle with a read posted in the ring. Remove one
+    // in the middle, twice: the raw connection at the low slot, and one of the
+    // clients. Under the old compaction both of these orphaned another
+    // connection's pending read.
+    os_compat.close(sacrificial);
+    os_compat.close(clients[1].socket_fd);
+
+    // Every connection that survived must still answer, with its own value.
+    for (&clients, 0..) |*client, i| {
+        if (i == 1) continue; // closed above
+
+        // No poll here on purpose: WildClient.get sends the request and then
+        // waits, so polling first would wait for a response that has not been
+        // asked for. The watchdog is what turns a stuck connection into a
+        // failure with a reason.
+        const key = try std.fmt.allocPrint(alloc, "ck{}", .{i});
+        const got = try client.get(key, alloc);
+        const expected = try std.fmt.allocPrint(alloc, "value-from-{d}", .{i});
+        const actual = got orelse fail("client {d}: get returned null", .{i});
+        if (!std.mem.eql(u8, actual, expected)) {
+            fail("client {d}: got '{s}' expected '{s}' — responses crossed connections", .{ i, actual, expected });
+        }
+    }
+
+    // A new connection lands on a freed slot. It must not inherit anything from
+    // the connection that used to own it, and it must see committed data.
+    const reused = connectAndAuthenticate("reused");
+    var fresh = try client_mod.WildClient.init("127.0.0.1", port);
+    try fresh.connect();
+    fresh.authenticate(secret) catch |err| fail("reused client: authenticate: {t}", .{err});
+
+    const seen = try fresh.get("ck0", alloc);
+    const want = try std.fmt.allocPrint(alloc, "value-from-{d}", .{0});
+    if (seen == null or !std.mem.eql(u8, seen.?, want)) {
+        fail("reused connection read '{s}' expected '{s}'", .{ seen orelse "<null>", want });
+    }
+
+    // A write on the reused slot must work too, so the slot is fully live.
+    fresh.set("fresh-key", "fresh-value") catch |err| fail("reused client: set: {t}", .{err});
+    const back = try fresh.get("fresh-key", alloc);
+    if (back == null or !std.mem.eql(u8, back.?, "fresh-value")) {
+        fail("reused connection could not read back its own write", .{});
+    }
+
+    os_compat.close(reused);
+
+    srv.requestShutdown();
+
+    std.debug.print("e2e-concurrency: PASS {} connections kept their own responses across two disconnects,\n", .{survivors - 1});
+    std.debug.print("  and a freed slot was reused without inheriting stale state\n", .{});
+}
diff --git a/tests/e2e_pipelined.zig b/tests/e2e_pipelined.zig
new file mode 100644
index 0000000..cd4ad00
--- /dev/null
+++ b/tests/e2e_pipelined.zig
@@ -0,0 +1,253 @@
+//! Concurrent request test for the io_uring accept loop.
+//!
+//! Many connections each send one GET, all before any response is read. That is
+//! the shape the server batches: one drain of the completion queue holds many
+//! lookups, and they go to storage together. The test asserts the server really
+//! grouped them, through its own counters, so the batching cannot quietly become
+//! dead code.
+//!
+//! Each connection keeps one request outstanding at a time, and that is a
+//! protocol limit rather than a choice made here. The header the server parses
+//! carries the operation and the value length, but not the key length, so a read
+//! that returns two messages glued together cannot be split: the server hashes
+//! the tail as part of one key and answers `not found`. A client that pipelines
+//! therefore gets wrong answers. docs/MIGRATION_0.17.md records it as an open
+//! defect, together with the fact that docs/WIRE_PROTOCOL.md describes a 16-byte
+//! header with a length field that the implementation does not use.
+//!
+//! Run with: zig build && ./zig-out/bin/e2e-pipelined
+
+const std = @import("std");
+const wildb_lib = @import("wildb_lib");
+
+const wild = wildb_lib.wild;
+const server_mod = wildb_lib.server;
+const static_allocator = wildb_lib.static_allocator;
+const os_compat = wildb_lib.os_compat;
+
+const secret = "pipelined-secret";
+const port: u16 = 7912;
+const num_connections = 256;
+const keys_per_connection = 4;
+const pipelined_gets = 200;
+const watchdog_ms = 30_000;
+
+const op_get: u8 = 2; // Operation.get on the wire
+
+fn fail(comptime format: []const u8, args: anytype) noreturn {
+    std.debug.print("e2e-pipelined: FAIL " ++ format ++ "\n", args);
+    std.process.exit(1);
+}
+
+fn serve(srv: *server_mod.WildServer) void {
+    srv.start() catch |err| {
+        std.debug.print("e2e-pipelined: server stopped: {t}\n", .{err});
+    };
+}
+
+/// A stuck server would otherwise hang the suite.
+fn watchdog() void {
+    var waited: u64 = 0;
+    while (waited < watchdog_ms) : (waited += 100) {
+        os_compat.sleep(100 * std.time.ns_per_ms);
+    }
+    std.debug.print("e2e-pipelined: FAIL no reply within {}ms\\n", .{watchdog_ms});
+    std.process.exit(1);
+}
+
+fn connectAndAuthenticate(who: []const u8) os_compat.fd_t {
+    const fd = os_compat.socket(std.posix.AF.INET, std.posix.SOCK.STREAM, 0) catch |err| {
+        fail("{s}: socket: {t}", .{ who, err });
+    };
+    var addr = os_compat.Address.parseIp("127.0.0.1", port) catch |err| {
+        fail("{s}: parseIp: {t}", .{ who, err });
+    };
+    os_compat.connect(fd, &addr.any, addr.getOsSockLen()) catch |err| {
+        fail("{s}: connect: {t}", .{ who, err });
+    };
+
+    os_compat.sendAllCompat(fd, secret) catch |err| fail("{s}: send secret: {t}", .{ who, err });
+
+    var ack: [1]u8 = undefined;
+    readExact(fd, &ack, "{s}: auth reply", .{who}) catch |err| fail("{s}: auth reply: {t}", .{ who, err });
+    if (ack[0] != 0) fail("{s}: auth refused", .{who});
+
+    return fd;
+}
+
+fn readExact(fd: os_compat.fd_t, buf: []u8, comptime format: []const u8, args: anytype) !void {
+    var filled: usize = 0;
+    while (filled < buf.len) {
+        const n = try os_compat.recv(fd, buf[filled..], 0);
+        if (n == 0) {
+            fail(format ++ " — connection closed after {d} of {d} bytes", args ++ .{ filled, buf.len });
+        }
+        filled += n;
+    }
+}
+
+/// GET on the wire: one operation byte, one value-length byte, then the key.
+fn sendGet(fd: os_compat.fd_t, key: []const u8) void {
+    var msg: [2 + 255]u8 = undefined;
+    if (key.len == 0 or key.len > 255) fail("bad key length {d}", .{key.len});
+    msg[0] = op_get;
+    msg[1] = 0;
+    @memcpy(msg[2 .. 2 + key.len], key);
+    os_compat.sendAllCompat(fd, msg[0 .. 2 + key.len]) catch |err| {
+        fail("send GET: {t}", .{err});
+    };
+}
+
+/// Read one response. Status 0 carries a length byte and the value.
+fn readResponse(fd: os_compat.fd_t, buf: []u8) !?[]const u8 {
+    var status: [1]u8 = undefined;
+    try readExact(fd, &status, "response status", .{});
+
+    switch (status[0]) {
+        0 => {}, // ok, a value follows
+        1 => return null, // not found
+        else => fail("server returned error status {d}", .{status[0]}),
+    }
+
+    var len_buf: [1]u8 = undefined;
+    try readExact(fd, &len_buf, "value length", .{});
+    const len: usize = len_buf[0];
+    if (len > buf.len) fail("value length {d} exceeds the buffer", .{len});
+
+    try readExact(fd, buf[0..len], "value", .{});
+    return buf[0..len];
+}
+
+fn keyName(alloc: std.mem.Allocator, connection: usize, index: usize) []const u8 {
+    return std.fmt.allocPrint(alloc, "pipe-{d}-{d}", .{ connection, index }) catch fail("out of memory", .{});
+}
+
+fn valueOf(alloc: std.mem.Allocator, connection: usize, index: usize) []const u8 {
+    return std.fmt.allocPrint(alloc, "v-{d}-{d}", .{ connection, index }) catch fail("out of memory", .{});
+}
+
+pub fn main() !void {
+    var arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
+    defer arena.deinit();
+    const alloc = arena.allocator();
+
+    var database_arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
+    defer database_arena.deinit();
+    var static_alloc = static_allocator.StaticAllocator.init(database_arena.allocator());
+
+    // Big enough that a lookup does not stay in L1, which is where batching is
+    // supposed to matter.
+    var database = try wild.WILD.init(static_alloc.allocator(), .{ .target_capacity = 2_000_000 });
+
+    var srv = try server_mod.WildServer.init(&database, &static_alloc, "127.0.0.1", port, secret);
+    static_alloc.transitionToStatic();
+
+    const thread = try std.Thread.spawn(.{}, serve, .{&srv});
+    defer thread.join();
+
+    _ = std.Thread.spawn(.{}, watchdog, .{}) catch {};
+
+    // Wait for the listener.
+    var attempt: usize = 0;
+    while (true) : (attempt += 1) {
+        const probe = os_compat.socket(std.posix.AF.INET, std.posix.SOCK.STREAM, 0) catch |err| {
+            fail("probe socket: {t}", .{err});
+        };
+        var addr = try os_compat.Address.parseIp("127.0.0.1", port);
+        if (os_compat.connect(probe, &addr.any, addr.getOsSockLen())) {
+            os_compat.close(probe);
+            break;
+        } else |_| {
+            os_compat.close(probe);
+            if (attempt > 400) fail("the server never listened on {}", .{port});
+            os_compat.sleep(5 * std.time.ns_per_ms);
+        }
+    }
+
+    // Load every key the test will ask for, over one connection.
+    {
+        const loader = connectAndAuthenticate("loader");
+        for (0..num_connections) |c| {
+            for (0..keys_per_connection) |k| {
+                const key = keyName(alloc, c, k);
+                const value = valueOf(alloc, c, k);
+                // SET on the wire: op, value length, key, value.
+                var msg: [2 + 255 + 52]u8 = undefined;
+                msg[0] = 1;
+                msg[1] = @intCast(value.len);
+                @memcpy(msg[2 .. 2 + key.len], key);
+                @memcpy(msg[2 + key.len ..][0..value.len], value);
+                os_compat.sendAllCompat(loader, msg[0 .. 2 + key.len + value.len]) catch |err| {
+                    fail("load SET: {t}", .{err});
+                };
+                var ack: [1]u8 = undefined;
+                try readExact(loader, &ack, "load ack", .{});
+                if (ack[0] != 0) fail("load SET refused", .{});
+            }
+        }
+        os_compat.close(loader);
+    }
+
+    // Phase 1: one round per key index. Every connection has a request in
+    // flight at the same moment, which is what makes one drain carry many
+    // lookups, and no connection has two outstanding, which the protocol cannot
+    // express.
+    const fds = try alloc.alloc(os_compat.fd_t, num_connections);
+    for (fds) |*fd| {
+        fd.* = connectAndAuthenticate("client");
+    }
+
+    var value_buf: [52]u8 = undefined;
+    for (0..keys_per_connection) |k| {
+        for (fds, 0..) |fd, c| sendGet(fd, keyName(alloc, c, k));
+
+        for (fds, 0..) |fd, c| {
+            const got = try readResponse(fd, &value_buf);
+            const expected = valueOf(alloc, c, k);
+            const actual = got orelse fail("connection {d} key {d}: not found", .{ c, k });
+            if (!std.mem.eql(u8, actual, expected)) {
+                fail("connection {d} key {d}: got '{s}' expected '{s}'", .{ c, k, actual, expected });
+            }
+        }
+    }
+
+    const batches = srv.batches.load(.monotonic);
+    const batched_reads = srv.batched_reads.load(.monotonic);
+    if (batched_reads == 0) fail("the batch path was never used", .{});
+    if (batches >= batched_reads) {
+        fail("nothing was ever grouped: {d} batches for {d} batched reads", .{ batches, batched_reads });
+    }
+    std.debug.print("e2e-pipelined: {} GETs answered in {} batches (average {d:.1} per batch)\n", .{
+        batched_reads, batches, @as(f64, @floatFromInt(batched_reads)) / @as(f64, @floatFromInt(batches)),
+    });
+
+    for (fds) |fd| os_compat.close(fd);
+
+    // Phase 2: one connection, many requests in sequence. A connection only
+    // ever has one posted read, so this asks whether a long-lived connection
+    // keeps working: every request gets its answer, and the slot stays usable
+    // over hundreds of round trips.
+    {
+        const steady = connectAndAuthenticate("steady");
+
+        const single = keyName(alloc, 0, 0);
+        const expected = valueOf(alloc, 0, 0);
+
+        for (0..pipelined_gets) |i| {
+            sendGet(steady, single);
+            const got = try readResponse(steady, &value_buf);
+            const actual = got orelse fail("request {d} on a long-lived connection: not found", .{i});
+            if (!std.mem.eql(u8, actual, expected)) {
+                fail("request {d} on a long-lived connection: got '{s}' expected '{s}'", .{ i, actual, expected });
+            }
+        }
+
+        os_compat.close(steady);
+    }
+
+    srv.requestShutdown();
+
+    std.debug.print("e2e-pipelined: PASS {} connections x {} keys answered in batches, and {} requests on one long-lived connection\n", .{
+        num_connections, keys_per_connection, pipelined_gets,
+    });
+}
diff --git a/tests/e2e_server.zig b/tests/e2e_server.zig
new file mode 100644
index 0000000..d1369b6
--- /dev/null
+++ b/tests/e2e_server.zig
@@ -0,0 +1,51 @@
+//! Starts the real WILD server for end-to-end testing.
+//!
+//! This is the production server (`src/server.zig`, io_uring accept loop and
+//! all) with the production database. It exists because the daemon
+//! (`src/daemon.zig`) never starts the client-facing server, so there is
+//! otherwise no supported way to exercise the TCP path.
+//!
+//! Build it with `zig build`, then run the pair:
+//!
+//!     ./zig-out/bin/e2e-server 7878 testsecret
+//!     ./zig-out/bin/e2e-client 127.0.0.1:7878 testsecret
+//!
+//! The server blocks until the process is killed.
+
+const std = @import("std");
+const wildb_lib = @import("wildb_lib");
+
+const wild = wildb_lib.wild;
+const server = wildb_lib.server;
+const static_allocator = wildb_lib.static_allocator;
+
+pub fn main(init: std.process.Init) !void {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+
+    if (args.len < 3) {
+        std.debug.print("Usage: e2e-server <port> <auth-secret> [capacity]\n", .{});
+        return error.Usage;
+    }
+
+    const port = try std.fmt.parseInt(u16, args[1], 10);
+    const auth_secret = args[2];
+    const capacity = if (args.len > 3) try std.fmt.parseInt(usize, args[3], 10) else 100_000;
+
+    var arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
+    defer arena.deinit();
+
+    var database_arena = std.heap.ArenaAllocator.init(arena.allocator());
+    var static_alloc = static_allocator.StaticAllocator.init(database_arena.allocator());
+
+    var database = try wild.WILD.init(static_alloc.allocator(), .{
+        .target_capacity = capacity,
+    });
+
+    // WildServer.allocates from the static allocator, so init must run before
+    // the transition. start() then blocks and serves forever.
+    var wild_server = try server.WildServer.init(&database, &static_alloc, "127.0.0.1", port, auth_secret);
+    static_alloc.transitionToStatic();
+
+    std.debug.print("e2e-server: database capacity {} records\n", .{capacity});
+    try wild_server.start();
+}
